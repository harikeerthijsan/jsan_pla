# Provisioned by .railway/railway.ts
APP_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
STORAGE_MODE=s3
BUCKET=${{pla-files.BUCKET}}
BUCKET_ENDPOINT=${{pla-files.ENDPOINT}}
BUCKET_ACCESS_KEY_ID=${{pla-files.ACCESS_KEY_ID}}
BUCKET_SECRET_ACCESS_KEY=${{pla-files.SECRET_ACCESS_KEY}}
BUCKET_REGION=${{pla-files.REGION}}
S3_ADDRESSING_STYLE=virtual
AUTO_CONFIGURE_BUCKET_CORS=true
BUCKET_CORS_ORIGINS=*
SEED_DEMO=false
WORKER_POLL_SECONDS=3
DB_CONNECT_TIMEOUT=120

# Set these three values before the first deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-12-or-more-characters
ADMIN_NAME=JSAN QC Admin
JWT_SECRET=replace-with-at-least-32-random-characters
