# Local developer machine. Copy values into api/.env (ignored by Git).
APP_ENV=development
DATABASE_URL=sqlite:///./pla_qc.db
STORAGE_MODE=local
LOCAL_STORAGE_ROOT=D:/PLA_QC_DATA/storage
LIDAR_PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5500
SEED_DEMO=false
# Local-only defaults are accepted outside staging/production; never reuse them anywhere shared.
JWT_SECRET=<local-random-value>
ADMIN_EMAIL=admin@jsan.local
ADMIN_PASSWORD=<local-password>
STAFF_INITIAL_PASSWORD=<local-staff-password-of-12+-chars>
